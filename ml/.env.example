# Aether ML service - environment variables
# For local development this file is optional: the service also reads
# ../server/.env, so keys set there are picked up. Real environment
# variables always win over both files.

# --- LLM providers (basic tier: Ollama -> Groq -> Gemini; premium: Groq -> Gemini -> Ollama)
OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2            # default: chosen from the device RAM the client reports
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash    # also used for photos

# --- Vector search. Leave both empty to build an in-memory index at startup.
# QDRANT_URL=https://xyz.cloud.qdrant.io
# QDRANT_API_KEY=
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# --- Conversation state. Without MONGO_URI it is kept in memory.
# MONGO_URI=mongodb://localhost:27017/ai_doctor_db
# ENCRYPTION_KEY=                  # same 64-hex-char key as the backend; required to store state

# --- Clinician review before a final assessment is released
# off (default) | urgent (non-routine or not fully grounded) | all
# REVIEW_MODE=off

# --- Tuning (defaults shown)
# GROUNDING_CHECK=auto             # auto | always | never
# MAX_INTAKE_TURNS=6
# MAX_SEARCH_QUERIES=3             # topics the research step may search per assessment
# RESEARCH_MAX_ROUNDS=2            # a search that finds nothing is reworded once
# RERANK_ENABLED=false
# CHECKPOINT_TTL_S=2592000

# --- Tracing (optional). Prompts contain what users typed: only enable with a
# --- project you are allowed to send health data to.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=aether-consult
