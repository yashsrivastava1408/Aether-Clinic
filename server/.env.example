# AI Doctor Backend - Environment Variables Template
# Copy this file to .env and fill in your values

# ===============================
# ML Service
# ===============================
ML_BASE_URL=http://localhost:5001
# Intelligence Hub (Multi-Agent RAG) — same service as ML, different endpoints
INTELLIGENCE_BASE_URL=http://localhost:5001

# ===============================
# AI / LLM Settings
# ===============================
# Get your Gemini API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq key for the premium tier (optional): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Ollama host (if using local LLM)
OLLAMA_HOST=http://localhost:11434

# The chat is run by the Python service. For local development that service
# also reads this file, so the keys above are set once.
# CONSULT_TIMEOUT_MS=120000

# ===============================
# Security
# ===============================
# Generate a 64-character hex key for AES-256 encryption
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_char_hex_key_here

# ===============================
# Email Settings (for reports)
# ===============================
EMAIL_USER=your_email@gmail.com
# For Gmail, use App Password: https://myaccount.google.com/apppasswords
EMAIL_PASS=your_app_password_here

# ===============================
# Database
# ===============================
# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com/
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/ai_doctor_db?retryWrites=true&w=majority

# ===============================
# Agentic features
# ===============================
# Public address of the web app, used in check-in email links
APP_URL=http://localhost:5173
# Check-in emails after a consultation (opt-in per consultation; needs MongoDB and the email settings above)
# FOLLOWUPS_ENABLED=true
# FOLLOWUP_POLL_MS=600000
# Shared key for the clinician review queue (/review). Leave empty to disable the queue.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
REVIEWER_KEY=

# ===============================
# Server
# ===============================
PORT=5050
NODE_ENV=development
